# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API). Never commit .env.local.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NASA data placeholders: leave empty until a source is chosen and verified.
# See "NASA data: placeholders to connect" in README.md and src/config/nasaData.ts.
VITE_NASA_IMAGERY_URL=
VITE_NASA_ELEVATION_URL=
VITE_NASA_DTM_URL=
VITE_NASA_SLOPE_URL=
VITE_NASA_GEOLOGY_URL=
VITE_NASA_MINERALOGY_URL=
VITE_NASA_THERMAL_URL=
VITE_NASA_TRAVERSES_URL=
VITE_NASA_PLACENAMES_URL=
